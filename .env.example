# OpenRouter API Key
OPENROUTER_API_KEY=your_key_here

# Agent model (provider-prefixed Pydantic AI model string)
MODEL_NAME=openrouter:deepseek/deepseek-v4-flash

# Temp clone cleanup
# Untracked leftover repo clones older than this (seconds) are removed on
# startup and then every hour.
SESSION_ORPHAN_MAX_AGE_SECONDS=3600

# CORS: comma-separated list of allowed origins. "*" allows all (credentials disabled).
CORS_ALLOW_ORIGINS=*

# Local Repository Target Control
# Set to false in production to disable initializing local filesystem paths via the API.
ALLOW_LOCAL_REPO_TARGETS=true

# Rate Limiting Controls (per hour per client IP and session ID)
MAX_MESSAGES_PER_HOUR=20
MAX_REPO_INITS_PER_HOUR=10
MAX_FILE_VIEWS_PER_HOUR=60
RATE_LIMIT_WINDOW_SECONDS=3600

# Repository Size Controls
MAX_REPO_FILES=200
MAX_REPO_SIZE_MB=50.0
MAX_VIEW_FILE_MB=1.0

# Langfuse Observability Configuration (optional)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
