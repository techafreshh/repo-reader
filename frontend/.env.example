# Base URL of the Repo Reader backend. In Docker this is served through the
# Nginx reverse proxy, so the relative "/api" path is correct.
VITE_API_BASE_URL=/api

# Optional: bearer token sent to the backend (leave empty if unused)
VITE_API_TOKEN=

# Optional: file upload endpoint. Uploads are disabled by default.
VITE_UPLOAD_URL=
VITE_ENABLE_UPLOADS=false

# Branding
VITE_APP_NAME=Repo-Reader
VITE_APP_DESCRIPTION=Chat with any codebase...
VITE_APP_LOGO_URL=
# Root-absolute path under public/ (must be a URL, not a file path)
VITE_FAVICON_URL=/githubs.svg
